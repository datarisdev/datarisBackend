# Copiar a .env para desarrollo local. No poner valores reales acá — este
# archivo se versiona en git.

# PostHog (ver docs/analytics/posthog.md en datarisInfra para el detalle completo).
# Deshabilitado por defecto. Solo se activa explícitamente vía variable de entorno;
# nunca hardcodear el token en el código.
POSTHOG_ENABLED=false
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=

# Copilotos agro con Azure OpenAI Responses API. En Azure Container Apps se
# recomienda Managed Identity: deja AZURE_OPENAI_API_KEY vacío y configura el
# rol "Cognitive Services OpenAI User" sobre el recurso.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_CONTEXTUAL_DEPLOYMENT=
AZURE_OPENAI_AERIAL_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_TOKEN_SCOPE=https://ai.azure.com/.default
AZURE_OPENAI_IMAGE_DETAIL=original
OPENAI_CONTEXTUAL_COPILOT_MAX_OUTPUT_TOKENS=3200
OPENAI_CONTEXTUAL_COPILOT_TIMEOUT_SECONDS=75
OPENAI_AERIAL_COPILOT_MAX_OUTPUT_TOKENS=2400
OPENAI_AERIAL_COPILOT_TIMEOUT_SECONDS=60

# Laboratorio de IA (entrenamiento de modelos de visión por computadora).
# Deshabilitado por defecto: sin esta variable la API de /ml responde
# "El módulo de entrenamiento de IA no está habilitado" para cualquier usuario,
# incluido el superadmin. Ponerla en true para desarrollo local.
ML_TRAINING_ENABLED=false
