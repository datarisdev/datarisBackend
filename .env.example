# Copiar a .env para desarrollo local. No poner valores reales acá — este
# archivo se versiona en git.

# PostHog (ver docs/analytics/posthog.md en datarisInfra para el detalle completo).
# Deshabilitado por defecto. Solo se activa explícitamente vía variable de entorno;
# nunca hardcodear el token en el código.
POSTHOG_ENABLED=false
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=
